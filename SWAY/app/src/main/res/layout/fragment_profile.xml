<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/textProfileAvatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textProfileLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/sway_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textProfileNickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/sway_text"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textGuestSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/guest_subtitle"
        android:textColor="@color/sway_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonGuestLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_primary_button"
        android:text="@string/sign_in"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone"
        app:backgroundTint="@null" />

    <Button
        android:id="@+id/buttonGuestRegister"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_outline_button"
        android:text="@string/sign_up"
        android:textAllCaps="false"
        android:textColor="@color/sway_text"
        android:textSize="15sp"
        android:visibility="gone"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/textProfileEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/sway_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/buttonSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_profile_row"
        android:clickable="true"
        android:drawableEnd="@drawable/ic_chevron"
        android:drawableTint="@color/sway_muted"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/settings_title"
        android:textColor="@color/sway_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/buttonMyTrips"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_profile_row"
        android:clickable="true"
        android:drawableEnd="@drawable/ic_chevron"
        android:drawableTint="@color/sway_muted"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/profile_my_trips"
        android:textColor="@color/sway_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/buttonLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_profile_row"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/log_out"
        android:textColor="@color/sway_error"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
